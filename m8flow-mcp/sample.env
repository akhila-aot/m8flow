# ============================================================================
# m8flow MCP Server
#
# Copy this file to `.env` and update the values for your environment.
#
# Authentication priority:
#   1. Browser login (OIDCProxy) - Remote/HTTP mode
#   2. Static bearer token
#   3. Username/password (ROPC)
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

SERVER_TYPE=stdio          # stdio (Claude Desktop) | remote (Cursor/HTTP)
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# m8flow Backend
# ----------------------------------------------------------------------------

M8FLOW_API_URL=http://localhost:6840
M8FLOW_API_TIMEOUT=30

# ----------------------------------------------------------------------------
# Keycloak Configuration
# ----------------------------------------------------------------------------

KEYCLOAK_URL=http://localhost:6842
KEYCLOAK_REALM=m8flow

# Keycloak client used by the MCP server
CLIENT_ID=m8flow-backend

# Required for browser (OIDC) authentication
CLIENT_SECRET=

# Path to a public key file used to verify JWTs locally (optional; omit to
# skip local verification and rely on the backend/Keycloak instead).
AUTHZ_SERVER_PUBLIC_KEY_PATH=

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Seconds before a ROPC-issued token expires to proactively refresh it.
TOKEN_REFRESH_MARGIN=30

# Method 1 - Static Bearer Token
# M8FLOW_BEARER_TOKEN=eyJhbGciOiJSUzI1NiIs...

# Method 2 - Username / Password (ROPC)
# Requires Direct Access Grants enabled on the client.
# KEYCLOAK_USERNAME=
# KEYCLOAK_PASSWORD=

# Method 3 - Browser Login (Remote Mode)
OIDC_CONFIG_URL=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration

REQUIRED_SCOPES=openid,profile,email
VERIFY_ID_TOKEN=true

# Public URL of this MCP server.
# Required only in remote mode.
# Example:
# MCP_OIDC_BASE_URL=http://localhost:8000
# MCP_OIDC_ISSUER_URL=http://localhost:8000

MCP_OIDC_BASE_URL=
MCP_OIDC_ISSUER_URL=

MCP_OIDC_REDIRECT_PATH=/oauth/callback

# Require the OAuth consent screen during browser login. Leave false for silent SSO.
MCP_OIDC_REQUIRE_CONSENT=false

# ----------------------------------------------------------------------------
# Multi-tenancy
# ----------------------------------------------------------------------------

# Fallback tenant id used for service / global-realm tokens with no
# organization membership (no multi-tenant selection applies to them).
DEFAULT_TENANT_ID=

# SpiffWorkflow-Authentication-Identifier sent to the backend's tenant
# finalization endpoint. Leave unset to default to KEYCLOAK_REALM.
SHARED_REALM_IDENTIFIER=

# Keycloak client scope requested at sign-in so the token enumerates the
# user's organization memberships (enables multi-tenant selection). Set
# empty to disable.
ORGANIZATION_SCOPE=organization

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json           # json | text

# ----------------------------------------------------------------------------
# Development
# ----------------------------------------------------------------------------

DEBUG=false
RELOAD=false